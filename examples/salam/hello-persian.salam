// Salam also accepts Persian keywords for the same syntax.
کارکرد جمع(الف: صحیح, ب: صحیح): صحیح:
    بازگشت الف + ب
پایان

کارکرد فاکتوریل(الف: صحیح): صحیح:
    اگر الف > 1:
        بازگشت الف * فاکتوریل(الف - 1)
    وگرنه:
        بازگشت 1
    پایان
پایان

کارکرد آغازین:
    چاپ جمع(2, 3)

    گذرا شمارنده := 1
    تاهنگام شمارنده < 5:
        چاپ "شمارنده کنونی: " + شمارنده
        چاپ "فاکتوریل " + شمارنده + " برابر است با " + فاکتوریل(شمارنده)
        چاپ "---"
        شمارنده += 1
    پایان
پایان
